<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - NovaSphere</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

  <style>
    :root {
      --primary-color: #0d47a1;
      --accent-color: #42a5f5;
      --text-dark: #212529;
    }

    body {
      padding-top: 76px;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .navbar {
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
      background-color: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(10px);
    }

    .navbar-brand {
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--primary-color) !important;
    }

    .hero-section {
      background: linear-gradient(135deg, #f0f4f8 0%, #e1e8ed 100%);
      padding: 120px 0 100px;
      position: relative;
      overflow: hidden;
    }

    .hero-tagline {
      color: var(--accent-color);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      display: block;
    }

    .feature-card {
      padding: 2.5rem;
      border-radius: 1rem;
      background: white;
      transition: all 0.3s ease;
      height: 100%;
      border: 1px solid #eee;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 1rem 2rem rgba(0,0,0,0.08);
      border-color: var(--accent-color);
    }

    .feature-icon {
      width: 4rem;
      height: 4rem;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      background-color: rgba(13, 71, 161, 0.1);
      color: var(--primary-color);
      font-size: 2rem;
    }

    .feature-list {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
    }

    .feature-list li {
      font-size: 0.9rem;
      color: #6c757d;
      padding: 0.3rem 0;
      border-bottom: 1px solid #f0f0f0;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .feature-list li:last-child {
      border-bottom: none;
    }

    .feature-list li i {
      color: var(--primary-color);
      margin-top: 2px;
      flex-shrink: 0;
    }

    .advanced-badge {
      font-size: 0.7rem;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      padding: 2px 8px;
      border-radius: 20px;
      font-weight: 600;
      white-space: nowrap;
      vertical-align: middle;
    }

    /* Sprint Roadmap */
    .sprint-section {
      background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%);
      color: white;
    }

    .sprint-card {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 1rem;
      padding: 2rem;
      height: 100%;
      backdrop-filter: blur(5px);
    }

    .sprint-card .sprint-badge {
      display: inline-block;
      background: rgba(255,255,255,0.2);
      border: 1px solid rgba(255,255,255,0.4);
      color: white;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .sprint-story {
      background: rgba(255,255,255,0.05);
      border-radius: 0.5rem;
      padding: 0.75rem 1rem;
      margin-bottom: 0.5rem;
      border-left: 3px solid rgba(255,255,255,0.3);
      font-size: 0.9rem;
    }

    .sprint-story:last-child {
      margin-bottom: 0;
    }

    .sprint-story .epic-tag {
      font-size: 0.7rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }

    .value-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 2px;
    }

    /* Pricing */
    .pricing-card {
      transition: all 0.3s;
      border: 1px solid #dee2e6;
      border-radius: 1rem;
      overflow: visible;
    }

    .pricing-card:hover {
      transform: scale(1.02);
      box-shadow: 0 1rem 3rem rgba(0,0,0,0.1);
    }

    .pricing-header {
      background: #f8f9fa;
      padding: 2rem 0;
      border-bottom: 1px solid #eee;
      border-radius: 1rem 1rem 0 0;
    }

    .card-pro {
      border: 2px solid var(--primary-color);
      position: relative;
    }

    .badge-popular {
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary-color);
      color: white;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      white-space: nowrap;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    /* About Section */
    .founder-card {
      text-align: center;
      padding: 2rem;
      background: #f8f9fa;
      border-radius: 1rem;
      transition: transform 0.3s;
    }
    .founder-card:hover {
      transform: translateY(-5px);
      background: #fff;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }
    .founder-avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background-color: #e9ecef;
      margin: 0 auto 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      color: var(--primary-color);
      border: 4px solid white;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    section {
      padding: 100px 0;
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
      <a class="navbar-brand fs-3" href="#">
        <i class="bi bi-box-seam-fill me-2"></i>NovaSphere
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#features">Solutions</a></li>
          <li class="nav-item"><a class="nav-link" href="#roadmap">Roadmap</a></li>
          <li class="nav-item"><a class="nav-link" href="#pricing">Pricing</a></li>
          <li class="nav-item"><a class="nav-link" href="#about">About Trinova</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item ms-lg-3">
            <a href="/auth/login" class="btn btn-primary px-4">START APP</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section id="home" class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <span class="hero-tagline">By Trinova Company</span>
          <h1 class="display-3 fw-bold mb-4 text-dark">Stay Ahead,<br>Finish On Time!</h1>
          <p class="lead text-muted mb-5">
            Empowering construction professionals with a unified platform to centralize project data and streamline material procurement. Manage users, suppliers, projects, materials, ratings, and AI-driven analytics — all in one place.
          </p>
          <div class="d-flex gap-3">
            <a href="/auth/login" class="btn btn-primary btn-lg px-5 shadow-sm">START APP</a>
            <a href="#features" class="btn btn-outline-secondary btn-lg px-4">Explore Features</a>
          </div>
          <div class="mt-5 text-muted small">
            <i class="bi bi-check-circle-fill text-success me-2"></i>Cloud SaaS
            <span class="mx-3">|</span>
            <i class="bi bi-check-circle-fill text-success me-2"></i>On-Premise Options
            <span class="mx-3">|</span>
            <i class="bi bi-check-circle-fill text-success me-2"></i>Real-Time Tracking
            <span class="mx-3">|</span>
            <i class="bi bi-check-circle-fill text-success me-2"></i>AI-Powered Alerts
          </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="p-5 text-center">
             <i class="bi bi-buildings text-primary opacity-25" style="font-size: 15rem;"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="bg-white">
    <div class="container">
      <div class="text-center mb-5 mw-75 mx-auto">
        <h2 class="fw-bold display-6 mb-3">Complete Feature Suite</h2>
        <p class="text-muted fs-5">Six integrated modules covering every aspect of construction project and supply chain management.</p>
      </div>

      <div class="row g-4">

        <!-- Feature 1: User Management -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-people-fill"></i>
            </div>
            <h4>User Management</h4>
            <p class="text-muted">Full employee lifecycle management with role-based access control.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Create employee accounts with activation email</li>
              <li><i class="bi bi-check2"></i>Modify employee name, email, department & role</li>
              <li><i class="bi bi-check2"></i>Deactivate or permanently delete accounts</li>
              <li><i class="bi bi-check2"></i>Assign roles: Administrator, Project Manager, Supervisor</li>
            </ul>
          </div>
        </div>

        <!-- Feature 2: Supplier Management -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-shop"></i>
            </div>
            <h4>Supplier Management</h4>
            <p class="text-muted">Centralised supplier directory with full profile and audit trail.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Add suppliers with contact, catalog & pricing</li>
              <li><i class="bi bi-check2"></i>Update supplier info with timestamped change history</li>
              <li><i class="bi bi-check2"></i>Delete suppliers with active-project safeguard</li>
            </ul>
          </div>
        </div>

        <!-- Feature 3: Project Management -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-kanban-fill"></i>
            </div>
            <h4>Project Management</h4>
            <p class="text-muted">End-to-end project lifecycle from creation to completion.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Create projects with budget, timeline & team</li>
              <li><i class="bi bi-check2"></i>Real-time milestones, task completion & budget alerts</li>
              <li><i class="bi bi-check2"></i>Assign tasks to employees with deadlines</li>
              <li><i class="bi bi-check2"></i>Dashboard view of all assignments & statuses</li>
            </ul>
          </div>
        </div>

        <!-- Feature 4: Material Management -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-truck"></i>
            </div>
            <h4>Material Management</h4>
            <p class="text-muted">Track every material from order to acceptance — with quality gates.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Bill of materials per project phase or task</li>
              <li><i class="bi bi-check2"></i>Real-time order & delivery status tracking</li>
              <li><i class="bi bi-check2"></i>Quality inspection with photo/document attachments</li>
              <li><i class="bi bi-check2"></i>Flag non-compliant deliveries with supplier accountability</li>
            </ul>
          </div>
        </div>

        <!-- Feature 5: Supplier Rating -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-star-fill"></i>
            </div>
            <h4>Supplier Rating</h4>
            <p class="text-muted">Data-driven supplier evaluation with performance benchmarking.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Rate on price, delivery timeliness & quality per transaction</li>
              <li><i class="bi bi-check2"></i>Historical performance timeline with date & project filters</li>
              <li><i class="bi bi-check2"></i>Benchmark against industry standards <span class="advanced-badge">Advanced</span></li>
              <li><i class="bi bi-check2"></i>Trend analytics with top/at-risk supplier highlights <span class="advanced-badge">Advanced</span></li>
            </ul>
          </div>
        </div>

        <!-- Feature 6: Reporting & Analytics -->
        <div class="col-md-4">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-graph-up-arrow"></i>
            </div>
            <h4>Reporting & Analytics</h4>
            <p class="text-muted">From basic summaries to AI-powered predictive intelligence.</p>
            <ul class="feature-list">
              <li><i class="bi bi-check2"></i>Project status, material & supplier summary reports (PDF/Excel)</li>
              <li><i class="bi bi-check2"></i>Multi-dimensional cost, schedule & quality KPI dashboard <span class="advanced-badge">Advanced</span></li>
              <li><i class="bi bi-check2"></i>SRMA: Monte Carlo delay simulation with S-curve <span class="advanced-badge">Advanced</span></li>
              <li><i class="bi bi-check2"></i>Ranked mitigation actions with cost-risk distribution <span class="advanced-badge">Advanced</span></li>
            </ul>
          </div>
        </div>

      </div>

      <div class="text-center mt-4">
        <small class="text-muted"><span class="advanced-badge">Advanced</span> features available in Pro+ and Enterprise tiers.</small>
      </div>
    </div>
  </section>

  <!-- Sprint Roadmap Section -->
  <section id="roadmap" class="sprint-section">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold display-6 mb-3">Delivery Roadmap</h2>
        <p class="opacity-75 fs-5">Three focused sprints. Every feature intentionally sequenced for maximum early value.</p>
      </div>

      <div class="row g-4">

        <!-- Sprint 1 -->
        <div class="col-lg-4">
          <div class="sprint-card">
            <div class="sprint-badge">Sprint 1 — Apr 27 – May 8</div>
            <h5 class="fw-bold mb-1">Foundation & Core Workflows</h5>
            <p class="opacity-60 small mb-3">20 dev-days &nbsp;·&nbsp; 20 story points</p>

            <div class="sprint-story">
              <div class="epic-tag">User Management</div>
              Create, Modify & Delete Employee Accounts
            </div>
            <div class="sprint-story">
              <div class="epic-tag">User Management</div>
              Assign Roles & Permissions (Admin / PM / Supervisor)
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Supplier Management</div>
              Add, Modify & Delete Suppliers
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Project Management</div>
              Create Project (budget, timeline, team)
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Project Management</div>
              Manage & Track Project (real-time status, alerts)
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Project Management</div>
              Assign Resources & Tasks to Team Members
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Supplier Rating</div>
              Rate Suppliers per Transaction
            </div>
          </div>
        </div>

        <!-- Sprint 2 -->
        <div class="col-lg-4">
          <div class="sprint-card">
            <div class="sprint-badge">Sprint 2 — May 11 – May 22</div>
            <h5 class="fw-bold mb-1">Materials, Quality & Insights</h5>
            <p class="opacity-60 small mb-3">16 dev-days &nbsp;·&nbsp; 20 story points capacity</p>

            <div class="sprint-story">
              <div class="epic-tag">Material Management</div>
              Manage Material Requirements (Bill of Materials)
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Material Management</div>
              Track Ordering & Delivery with Delay Alerts
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Material Management</div>
              Verify Material Quality (photos & documents)
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Material Management</div>
              Mark Non-compliant Materials & Notify PM
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Supplier Rating</div>
              Review Supplier Performance History
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Supplier Rating</div>
              Benchmark Supplier Performance <span class="advanced-badge">Advanced</span>
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Reporting</div>
              Generate Basic Reports (PDF / Excel)
            </div>
          </div>
        </div>

        <!-- Sprint 3 -->
        <div class="col-lg-4">
          <div class="sprint-card">
            <div class="sprint-badge">Sprint 3 — May 25 – Jun 5</div>
            <h5 class="fw-bold mb-1">AI Intelligence & Advanced Analytics</h5>
            <p class="opacity-60 small mb-3">15 dev-days &nbsp;·&nbsp; 20 story points capacity</p>

            <div class="sprint-story">
              <div class="epic-tag">Reporting &amp; Analytics</div>
              AI-Driven Predictive Delay Alerts (SRMA) <span class="advanced-badge">Advanced</span>
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Reporting &amp; Analytics</div>
              Monte Carlo Simulation with S-Curve Output <span class="advanced-badge">Advanced</span>
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Reporting &amp; Analytics</div>
              Ranked Mitigation Actions & Cost-Risk Distribution <span class="advanced-badge">Advanced</span>
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Reporting &amp; Analytics</div>
              In-depth Multi-dimensional Performance Analytics <span class="advanced-badge">Advanced</span>
            </div>
            <div class="sprint-story">
              <div class="epic-tag">Supplier Rating</div>
              Advanced Supplier Trend Analytics & Export <span class="advanced-badge">Advanced</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="bg-light">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold display-6">Flexible Deployment</h2>
        <p class="text-muted">From small contractors to government enterprises.</p>
      </div>

      <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">
        <!-- Free Tier -->
        <div class="col">
          <div class="card mb-4 rounded-4 shadow-sm pricing-card h-100 border-0">
            <div class="pricing-header">
              <h4 class="my-0 fw-normal">Basic</h4>
              <h1 class="card-title pricing-card-title mt-3">$0<small class="text-muted fw-light">/mo</small></h1>
            </div>
            <div class="card-body d-flex flex-column">
              <ul class="list-unstyled mt-3 mb-4 text-start mx-auto">
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Up to 10 Users</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Max 5 Projects</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Supplier Comparison & Rating</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Material Tracking</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Basic Reports</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Pro Tier -->
        <div class="col">
          <div class="card mb-4 rounded-4 shadow-sm pricing-card h-100 card-pro">
            <span class="badge-popular">MOST POPULAR</span>
            <div class="pricing-header bg-white">
              <h4 class="my-0 fw-bold text-primary">Pro & Pro+</h4>
              <h1 class="card-title pricing-card-title mt-3">Subscription<small class="text-muted fw-light"></small></h1>
              <small class="text-muted">Cloud SaaS Model</small>
            </div>
            <div class="card-body d-flex flex-column">
              <ul class="list-unstyled mt-3 mb-4 text-start mx-auto">
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>Unlimited</strong> Users & Projects</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Full Material Quality Verification</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Supplier Benchmarking</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>Pre-Delay Alerts (SRMA)</strong></li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Advanced Analytics & Reports</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Priority Support</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Enterprise Tier -->
        <div class="col">
          <div class="card mb-4 rounded-4 shadow-sm pricing-card h-100 border-0">
            <div class="pricing-header">
              <h4 class="my-0 fw-normal">Enterprise</h4>
              <h1 class="card-title pricing-card-title mt-3">On-Prem<small class="text-muted fw-light"></small></h1>
              <small class="text-muted">Private Server Deployment</small>
            </div>
            <div class="card-body d-flex flex-column">
              <ul class="list-unstyled mt-3 mb-4 text-start mx-auto">
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Full Data Control</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Custom Integrations (ERP/BIM)</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Government Compliance</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Monte Carlo AI Engine (SRMA)</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>Dedicated Account Manager</li>
                <li class="mb-2"><i class="bi bi-check2 text-primary me-2"></i>SLA-backed Support</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="bg-white">
    <div class="container">
      <div class="row justify-content-center mb-5">
        <div class="col-lg-10 text-center">
          <h2 class="fw-bold mb-4">About Trinova Company</h2>
          <p class="lead text-primary fw-bold mb-3">"Tri" (Three Pillars) + "Nova" (New Star)</p>
          <p class="lead text-muted mb-4">
            Our mission is to eliminate the inefficiencies that have plagued construction for decades.
            We believe that true success lies in the perfect balance of <strong>Cost, Schedule, and Quality</strong>.
          </p>
          <p class="text-muted fs-5">
            NovaSphere is our promise to be a guiding light for the industry, relentlessly pursuing bright, innovative solutions that set a new standard for how the world builds.
          </p>
        </div>
      </div>
    </div>
  </section>

