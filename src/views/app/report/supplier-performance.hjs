<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Novasphere</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="overflow-x-hidden">
  <div class="d-flex min-vh-100">
    <div class="bg-dark text-white p-3 d-flex flex-column flex-shrink-0 overflow-hidden"
         style="width: 250px; height: 100vh; position: sticky; top: 0; z-index: 1000;">
      <h4 class="mb-4">Novasphere</h4>
      <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item"><a href="/app/dashboard" class="nav-link text-white"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
        {{#permissions.canAccessMaterialCategory}}<li class="nav-item"><a href="/app/material-category" class="nav-link text-white"><i class="bi bi-folder"></i> Material Categories</a></li>{{/permissions.canAccessMaterialCategory}}
        {{#permissions.canAccessMaterial}}<li class="nav-item"><a href="/app/material" class="nav-link text-white"><i class="bi bi-box-seam"></i> Materials</a></li>{{/permissions.canAccessMaterial}}
        {{#permissions.canAccessProject}}<li class="nav-item"><a href="/app/project" class="nav-link text-white"><i class="bi bi-building"></i> Projects</a></li>{{/permissions.canAccessProject}}
        {{#permissions.canAccessSupplier}}<li class="nav-item"><a href="/app/supplier" class="nav-link text-white"><i class="bi bi-shop"></i> Suppliers</a></li>{{/permissions.canAccessSupplier}}
        {{#permissions.canAccessReport}}<li class="nav-item"><a href="/app/report" class="nav-link text-white active"><i class="bi bi-graph-up"></i> Reports</a></li>{{/permissions.canAccessReport}}
        {{#permissions.canAccessUser}}<li class="nav-item"><a href="/app/user" class="nav-link text-white"><i class="bi bi-people"></i> Users</a></li>{{/permissions.canAccessUser}}
        <li class="nav-item"><a href="/app/notification" class="nav-link text-white"><i class="bi bi-bell"></i> Notifications</a></li>
      </ul>
      <hr class="text-white">
      <div class="pt-2">
        <p class="mb-1"><small>{{ user.first_name }} {{ user.last_name }}</small></p>
        <p class="mb-1"><small class="text-muted">{{ user.email }}</small></p>
        <form action="/auth/logout" method="POST" class="mt-2">
          <button type="submit" class="btn btn-sm btn-outline-light w-100"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </form>
      </div>
    </div>

    <div class="flex-grow-1" style="min-width: 0;">
      <nav class="navbar navbar-light bg-light border-bottom px-4 sticky-top">
        <div class="container-fluid">
          <h5 class="mb-0">{{ title }}</h5>
          <span class="navbar-text">Welcome, {{ user.first_name }}!</span>
        </div>
      </nav>

      <div class="p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h4><i class="bi bi-shop me-2"></i>Supplier Performance Report</h4>
            <p class="text-muted mb-0">Advanced analytics with trend charts, on-time rates, and at-risk flagging</p>
          </div>
          <div class="d-flex gap-2">
            <a class="btn btn-outline-success" href="/app/report/export?type=supplier-performance&format=pdf">
              <i class="bi bi-file-pdf me-1"></i>PDF
            </a>
            <a class="btn btn-outline-primary" href="/app/report/export?type=supplier-performance&format=xlsx">
              <i class="bi bi-download me-1"></i>XLSX
            </a>
            <a href="/app/report" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
          </div>
        </div>

        <!-- Stats KPI Cards -->
        <div class="row g-4 mb-4">
          <div class="col-md-3">
            <div class="card border-primary h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <div><h6 class="text-muted mb-1">Total Suppliers</h6><h3 class="mb-0">{{ reportData.stats.total_suppliers }}</h3></div>
                  <div class="text-primary"><i class="bi bi-shop" style="font-size: 2rem;"></i></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-success h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <div><h6 class="text-muted mb-1">Active Suppliers</h6><h3 class="mb-0">{{ reportData.stats.active_suppliers }}</h3></div>
                  <div class="text-success"><i class="bi bi-check-circle" style="font-size: 2rem;"></i></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-warning h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <div><h6 class="text-muted mb-1">Average Rating</h6><h3 class="mb-0">{{ reportData.stats.average_rating }}</h3></div>
                  <div class="text-warning"><i class="bi bi-star-fill" style="font-size: 2rem;"></i></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-info h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <div><h6 class="text-muted mb-1">Highest Rating</h6><h3 class="mb-0">{{ reportData.stats.highest_rating }}</h3></div>
                  <div class="text-info"><i class="bi bi-trophy-fill" style="font-size: 2rem;"></i></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- AI Declining Trend Alert -->
        {{#hasAiDeclining}}
        <div class="alert alert-warning mb-4">
          <h6 class="alert-heading"><i class="bi bi-robot me-2"></i>AI Prediction — Rating Declining</h6>
          <p class="mb-2 small">Linear regression on 12-month rating history detected a downward trend for these suppliers:</p>
          <div class="row g-2 mt-1">
            {{#aiDecliningSuppliers}}
            <div class="col-md-4">
              <div class="d-flex align-items-center gap-2">
                <span class="text-danger fw-bold">↓</span>
                <strong>{{ name }}</strong>
                <span class="badge bg-warning text-dark">Predicted: {{ ai_predicted_rating }}</span>
              </div>
            </div>
            {{/aiDecliningSuppliers}}
          </div>
        </div>
        {{/hasAiDeclining}}

        <!-- At-Risk Alert -->
        {{#hasAtRisk}}
        <div class="alert alert-danger mb-4">
          <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>At-Risk Suppliers Detected</h6>
          <div class="row g-2 mt-1">
            {{#atRiskSuppliers}}
            <div class="col-md-6">
              <div class="d-flex align-items-center gap-2">
                <strong>{{ name }}</strong>
                {{#hasBadges}}
                {{#badges}}
                <span class="badge {{ cls }}">{{ text }}</span>
                {{/badges}}
                {{/hasBadges}}
              </div>
            </div>
            {{/atRiskSuppliers}}
          </div>
        </div>
        {{/hasAtRisk}}

        <!-- Top Performers Alert -->
        {{#hasTopPerformers}}
        <div class="alert alert-success mb-4">
          <h6 class="alert-heading"><i class="bi bi-trophy me-2"></i>Top Performers (Rating ≥ 4.0)</h6>
          <div class="row g-2 mt-1">
            {{#topPerformers}}
            <div class="col-md-4">
              <strong>{{ name }}</strong>
              <span class="badge bg-warning text-dark ms-1"><i class="bi bi-star-fill"></i> {{ rating }}</span>
            </div>
            {{/topPerformers}}
          </div>
        </div>
        {{/hasTopPerformers}}

        <!-- Chart Row 1: Trend Line + On-Time Rate -->
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Rating Trend — Top 5 Suppliers (12 months)</h6></div>
              <div class="card-body"><canvas id="trendChart" height="200"></canvas></div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>On-Time Delivery Rate %</h6></div>
              <div class="card-body"><canvas id="onTimeChart" height="200"></canvas></div>
            </div>
          </div>
        </div>

        <!-- Chart Row 2: Defect Rate -->
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-exclamation-circle me-2"></i>Defect Rate % (red = above 5%)</h6></div>
              <div class="card-body"><canvas id="defectChart" height="200"></canvas></div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Rating Distribution</h6></div>
              <div class="card-body">
                {{#reportData.ratingDistribution}}
                <div class="mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span><i class="bi bi-star-fill text-warning"></i> {{ rating_level }} Stars</span>
                    <strong>{{ count }}</strong>
                  </div>
                  <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: {{ count }}%">{{ count }}</div>
                  </div>
                </div>
                {{/reportData.ratingDistribution}}
                {{^reportData.ratingDistribution}}<p class="text-center text-muted">No rating data</p>{{/reportData.ratingDistribution}}
              </div>
            </div>
          </div>
        </div>

        <!-- Full Suppliers Table -->
        <div class="card">
          <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-table me-2"></i>All Suppliers Performance</h6></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>ID</th><th>Supplier Name</th><th>Status</th><th>Rating</th>
                    <th>On-Time %</th><th>Defect %</th><th>Avg Detail Rating</th><th>Projects</th><th>Risk</th>
                    <th>AI Trend</th>
                  </tr>
                </thead>
                <tbody>
                  {{#reportData.suppliers}}
                  <tr class="{{#is_at_risk}}table-danger{{/is_at_risk}}">
                    <td>{{ supplier_id }}</td>
                    <td><strong>{{ name }}</strong><br><small class="text-muted">{{ email }}</small></td>
                    <td>{{#is_active}}<span class="badge bg-success">Active</span>{{/is_active}}{{^is_active}}<span class="badge bg-secondary">Inactive</span>{{/is_active}}</td>
                    <td>
                      {{#rating}}<span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> {{ rating }}</span>{{/rating}}
                      {{^rating}}<span class="text-muted small">N/A</span>{{/rating}}
                    </td>
                    <td>
                      {{#on_time_rate}}<span class="{{#is_at_risk}}text-danger{{/is_at_risk}}{{^is_at_risk}}text-success{{/is_at_risk}}">{{ on_time_rate }}%</span>{{/on_time_rate}}
                      {{^on_time_rate}}<span class="text-muted small">N/A</span>{{/on_time_rate}}
                    </td>
                    <td>
                      {{#defect_rate}}<span class="{{#is_at_risk}}text-danger fw-bold{{/is_at_risk}}{{^is_at_risk}}text-dark{{/is_at_risk}}">{{ defect_rate }}%</span>{{/defect_rate}}
                      {{^defect_rate}}<span class="text-muted small">N/A</span>{{/defect_rate}}
                    </td>
                    <td>{{#avg_detailed_rating}}<span class="badge bg-info">{{ avg_detailed_rating }}</span>{{/avg_detailed_rating}}{{^avg_detailed_rating}}<span class="text-muted small">N/A</span>{{/avg_detailed_rating}}</td>
                    <td>{{ projects_count }}</td>
                    <td>{{#is_at_risk}}<span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill"></i> At Risk</span>{{/is_at_risk}}{{^is_at_risk}}<span class="badge bg-success">OK</span>{{/is_at_risk}}</td>
                    <td>
                      {{#ai_has_data}}
                      <span class="{{ ai_trend_class }}">{{ ai_trend_label }}</span>
                      <br><small class="text-muted">Next: <strong>{{ ai_predicted_rating }}</strong></small>
                      <br>
                      <small>
                        Train R²: <span class="{{ ai_accuracy_class }}">{{ ai_train_r2 }}</span> RMSE: {{ ai_train_rmse }}
                        {{#ai_has_test}}
                        <br>Test R²: <span class="{{ ai_accuracy_class }}">{{ ai_test_r2 }}</span> RMSE: {{ ai_test_rmse }}
                        {{/ai_has_test}}
                        <br><span class="badge" style="font-size:0.6rem;background:var(--bs-{{ ai_accuracy_class }})">{{ ai_accuracy_label }} accuracy</span>
                        <span class="text-muted">({{ ai_train_points }}tr / {{ ai_test_points }}te pts)</span>
                      </small>
                      {{/ai_has_data}}
                      {{^ai_has_data}}<span class="text-muted small">Not enough data</span>{{/ai_has_data}}
                    </td>
                  </tr>
                  {{/reportData.suppliers}}
                  {{^reportData.suppliers}}<tr><td colspan="9" class="text-center text-muted">No suppliers found</td></tr>{{/reportData.suppliers}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      var trendsData = {{{ trendsJson }}};
      var onTimeData = {{{ onTimeRatesJson }}};
      var defectData = {{{ defectRatesJson }}};

      if (trendsData && trendsData.labels && trendsData.labels.length > 0) {
        new Chart(document.getElementById('trendChart'), {
          type: 'line',
          data: trendsData,
          options: {
            responsive: true,
            plugins: { legend: { position: 'top' } },
            scales: { y: { min: 0, max: 5, title: { display: true, text: 'Avg Rating' } } }
          }
        });
      } else {
        document.getElementById('trendChart').parentElement.innerHTML = '<p class="text-center text-muted py-4">No trend data available yet</p>';
      }

      if (onTimeData && onTimeData.labels && onTimeData.labels.length > 0) {
        new Chart(document.getElementById('onTimeChart'), {
          type: 'bar',
          data: onTimeData,
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { min: 0, max: 100, title: { display: true, text: 'On-Time Rate %' } } }
          }
        });
      } else {
        document.getElementById('onTimeChart').parentElement.innerHTML = '<p class="text-center text-muted py-4">No on-time rate data available yet</p>';
      }

      if (defectData && defectData.labels && defectData.labels.length > 0) {
        new Chart(document.getElementById('defectChart'), {
          type: 'bar',
          data: defectData,
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { min: 0, title: { display: true, text: 'Defect Rate %' } } }
          }
        });
      } else {
        document.getElementById('defectChart').parentElement.innerHTML = '<p class="text-center text-muted py-4">No defect rate data available yet</p>';
      }
    })();
  </script>
</body>
</html>
