<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Novasphere</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="overflow-x-hidden">
  <div class="d-flex min-vh-100">
    <div class="bg-dark text-white p-3 d-flex flex-column flex-shrink-0 overflow-hidden"
         style="width: 250px; height: 100vh; position: sticky; top: 0; z-index: 1000;">
      <h4 class="mb-4">Novasphere</h4>
      <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item"><a href="/app/dashboard" class="nav-link text-white"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
        {{#permissions.canAccessMaterialCategory}}<li class="nav-item"><a href="/app/material-category" class="nav-link text-white"><i class="bi bi-folder"></i> Material Categories</a></li>{{/permissions.canAccessMaterialCategory}}
        {{#permissions.canAccessMaterial}}<li class="nav-item"><a href="/app/material" class="nav-link text-white"><i class="bi bi-box-seam"></i> Materials</a></li>{{/permissions.canAccessMaterial}}
        {{#permissions.canAccessProject}}<li class="nav-item"><a href="/app/project" class="nav-link text-white"><i class="bi bi-building"></i> Projects</a></li>{{/permissions.canAccessProject}}
        {{#permissions.canAccessSupplier}}<li class="nav-item"><a href="/app/supplier" class="nav-link text-white"><i class="bi bi-shop"></i> Suppliers</a></li>{{/permissions.canAccessSupplier}}
        {{#permissions.canAccessReport}}<li class="nav-item"><a href="/app/report" class="nav-link text-white active"><i class="bi bi-graph-up"></i> Reports</a></li>{{/permissions.canAccessReport}}
        {{#permissions.canAccessUser}}<li class="nav-item"><a href="/app/user" class="nav-link text-white"><i class="bi bi-people"></i> Users</a></li>{{/permissions.canAccessUser}}
        <li class="nav-item"><a href="/app/notification" class="nav-link text-white"><i class="bi bi-bell"></i> Notifications</a></li>
      </ul>
      <hr class="text-white">
      <div class="pt-2">
        <p class="mb-1"><small>{{ user.first_name }} {{ user.last_name }}</small></p>
        <p class="mb-1"><small class="text-muted">{{ user.email }}</small></p>
        <form action="/auth/logout" method="POST" class="mt-2">
          <button type="submit" class="btn btn-sm btn-outline-light w-100"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </form>
      </div>
    </div>

    <div class="flex-grow-1" style="min-width: 0;">
      <nav class="navbar navbar-light bg-light border-bottom px-4 sticky-top">
        <div class="container-fluid">
          <h5 class="mb-0">{{ title }}</h5>
          <span class="navbar-text">Welcome, {{ user.first_name }}!</span>
        </div>
      </nav>

      <div class="p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h4><i class="bi bi-cpu me-2"></i>Predictive Delay Analysis (SRMA)</h4>
            <p class="text-muted mb-0">Monte Carlo simulation — schedule risk &amp; mitigation advisor</p>
          </div>
          <a href="/app/report" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>

        <!-- Run SRMA Form -->
        <div class="card mb-4">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-play-circle me-2"></i>Run SRMA Analysis</h6>
          </div>
          <div class="card-body">
            <form method="POST" action="/app/report/predictive-delay/run" class="row g-3 align-items-end">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Select Project</label>
                <select name="projectId" class="form-select" required>
                  <option value="">— Choose project —</option>
                  {{#projects}}
                  <option value="{{ project_id }}">{{ name }}</option>
                  {{/projects}}
                </select>
              </div>
              <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                  <i class="bi bi-play-fill me-1"></i>Run Analysis (2000 iterations)
                </button>
              </div>
            </form>
            <p class="text-muted small mt-2 mb-0">
              <i class="bi bi-info-circle me-1"></i>
              Simulation runs synchronously (~2-5 seconds). Uses task durations and PMR delivery history as risk inputs.
            </p>
          </div>
        </div>

        <!-- No runs yet -->
        {{^hasRuns}}
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>
          No SRMA runs found. Select a project above and click "Run Analysis" to generate predictions.
        </div>
        {{/hasRuns}}

        <!-- Results per project -->
        {{#runsData}}
        <div class="card mb-4">
          <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-building me-2"></i>{{ project_name }}</h6>
            <span class="badge bg-secondary">Last run: {{ run.started_at }}</span>
          </div>
          <div class="card-body">

            <!-- Advisory Banner -->
            <div class="alert {{ alertClass }} mb-3">
              <i class="bi bi-robot me-2"></i><strong>Advisory:</strong> {{ advisoryText }}
            </div>

            <div class="row g-4 mb-3">
              <!-- S-Curve Chart -->
              <div class="col-md-6">
                <h6><i class="bi bi-graph-up me-1"></i>S-Curve (Completion Probability)</h6>
                <canvas id="scurve_{{ project_id }}" height="200"></canvas>
                {{#targetDuration}}
                <p class="text-muted small mt-1">Target: {{ targetDuration }} days</p>
                {{/targetDuration}}
              </div>

              <!-- Activity Criticality -->
              {{#hasActivity}}
              <div class="col-md-6">
                <h6><i class="bi bi-bar-chart-horizontal me-1"></i>Activity Criticality Index</h6>
                <canvas id="actcrit_{{ project_id }}" height="200"></canvas>
              </div>
              {{/hasActivity}}
              {{^hasActivity}}
              <div class="col-md-6">
                <div class="d-flex align-items-center justify-content-center h-100 text-muted py-4">
                  <span>No criticality data (no task dependencies configured)</span>
                </div>
              </div>
              {{/hasActivity}}
            </div>

            <!-- Ranked Mitigation Actions -->
            {{#hasMeasures}}
            <h6 class="mt-3"><i class="bi bi-shield-check me-1"></i>Ranked Mitigation Actions</h6>
            <div class="table-responsive mb-3">
              <table class="table table-sm table-hover">
                <thead><tr><th>Mitigation Measure</th><th>Usage Frequency</th><th>Avg Cost Contribution</th></tr></thead>
                <tbody>
                  {{#measureCriticality}}
                  <tr>
                    <td>{{ description }}</td>
                    <td><div class="progress" style="height:18px;"><div class="progress-bar bg-warning" style="width:{{ usage_pct }}%">{{ usage_pct }}%</div></div></td>
                    <td>NT${{ cost_fmt }}</td>
                  </tr>
                  {{/measureCriticality}}
                </tbody>
              </table>
            </div>
            {{/hasMeasures}}
            {{^hasMeasures}}
            <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>No mitigation measures configured for this project.</p>
            {{/hasMeasures}}

            <!-- Run History -->
            {{#hasHistory}}
            <h6 class="mt-3"><i class="bi bi-clock-history me-1"></i>Run History</h6>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead><tr><th>Started</th><th>Status</th><th>P(on-time)</th><th>Mean Net Cost</th><th>Iterations</th></tr></thead>
                <tbody>
                  {{#history}}
                  <tr>
                    <td>{{ started_at_fmt }}</td>
                    <td><span class="badge bg-{{ status }}">{{ status }}</span></td>
                    <td>{{#probability_pct}}{{ probability_pct }}%{{/probability_pct}}{{^probability_pct}}—{{/probability_pct}}</td>
                    <td>NT${{ mean_net_cost_fmt }}</td>
                    <td>{{ n_iterations }}</td>
                  </tr>
                  {{/history}}
                </tbody>
              </table>
            </div>
            {{/hasHistory}}

          </div>
        </div>
        {{/runsData}}

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      var runsData = {{{ runsDataJson }}};
      if (!runsData) return;
      runsData.forEach(function(rd) {
        var scurveEl = document.getElementById('scurve_' + rd.project_id);
        if (scurveEl && rd.scurveJson) {
          var data = JSON.parse(rd.scurveJson);
          new Chart(scurveEl, {
            type: 'line',
            data: data,
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              scales: {
                y: { min: 0, max: 100, title: { display: true, text: 'Cumulative Probability %' } },
                x: { title: { display: true, text: 'Duration (days)' } }
              }
            }
          });
        }
        var actEl = document.getElementById('actcrit_' + rd.project_id);
        if (actEl && rd.actCritJson) {
          var actData = JSON.parse(rd.actCritJson);
          new Chart(actEl, {
            type: 'bar',
            data: actData,
            options: {
              indexAxis: 'y',
              responsive: true,
              plugins: { legend: { display: false } },
              scales: { x: { min: 0, max: 1, title: { display: true, text: 'Criticality Index' } } }
            }
          });
        }
      });
    })();
  </script>
</body>
</html>
